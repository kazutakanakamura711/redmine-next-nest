# PostgreSQL for docker-compose.yml
# 実際の値は .env にコピーして設定する。.env は Git に commit しない。
POSTGRES_USER=redmine
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_DB=redmine_next_nest
POSTGRES_PORT=5432

# Prisma を host 側で実行するため、host は localhost にする。
DATABASE_URL=postgresql://redmine:change-me-for-local-development@localhost:5432/redmine_next_nest?schema=public

# API E2E 用の独立した PostgreSQL（docker compose --profile test up -d db-test）
POSTGRES_TEST_USER=redmine_test
POSTGRES_TEST_PASSWORD=change-me-for-local-test
POSTGRES_TEST_DB=redmine_next_nest_test
POSTGRES_TEST_PORT=5433
TEST_DATABASE_URL=postgresql://redmine_test:change-me-for-local-test@localhost:5433/redmine_next_nest_test?schema=public

# Local development servers
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
